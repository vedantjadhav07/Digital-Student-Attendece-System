# Lab-Secure Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Security: In production, generate a secure 64-char key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=lab_secure_dev_secret_key_8e94a8f93e2b47d10e5f96c3a1b8d24f

# SQLite Database Location
# Uses instance/attendance.db by default
DATABASE_URL=sqlite:///attendance.db

# SQLite Performance & Concurrency Tuning
SQLITE_TIMEOUT=15
SQLITE_WAL_MODE=True

# Network & Proxy Security
# Set to True if deploying behind Nginx or a reverse proxy
BEHIND_PROXY=False
TRUSTED_PROXIES=127.0.0.1

# Session Security
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False

# Rate Limiting
RATELIMIT_DEFAULT=200/day;50/hour

